#!/usr/bin/env python3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

import json
from harness import HarnessError, check_slug, find_workspace, main
from harness.frictions import record


def run(argv):
    if len(argv) != 2:
        raise HarnessError("usage: friction <cause-slug> <feature-slug>")
    print(json.dumps(record(find_workspace(), argv[0], check_slug(argv[1])), indent=2))


main(run)
