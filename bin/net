#!/usr/bin/env python3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from harness import HarnessError, check_slug, find_workspace, main
from harness.net import check, freeze


def run(argv):
    if len(argv) != 2 or argv[0] not in ("freeze", "check"):
        raise HarnessError("usage: net freeze <slug> | net check <slug>")
    ws, slug = find_workspace(), check_slug(argv[1])
    sha = freeze(ws, slug) if argv[0] == "freeze" else check(ws, slug)
    print("safety net %s: %s" % ("frozen at" if argv[0] == "freeze" else "matches", sha or "nothing frozen yet, no sub-task in state"))


main(run)
