#!/usr/bin/env python3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from harness import HarnessError, main
from harness.workspace import link


def run(argv):
    if len(argv) > 1:
        raise HarnessError("usage: link [workspace]")
    link(Path(argv[0] if argv else ".").resolve())


main(run)
