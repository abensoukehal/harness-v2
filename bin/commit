#!/usr/bin/env python3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from harness import HarnessError, check_slug, find_workspace, main
from harness.commit import commit


def run(argv):
    body = None
    if "--body" in argv:
        i = argv.index("--body")
        body = argv[i + 1] if i + 1 < len(argv) else ""
        del argv[i:i + 2]
    if len(argv) != 3:
        raise HarnessError("usage: commit <slug> <repo> <subject> [--body TEXT]")
    slug, repo, subject = argv
    print(commit(find_workspace(), check_slug(slug), repo, subject, body))


main(run)
