#!/usr/bin/env python3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from harness import HarnessError, check_slug, find_workspace, main
from harness.env import restart


def run(argv):
    if len(argv) < 2:
        raise HarnessError("usage: restart <slug> <stack> [<stack> ...]")
    restart(find_workspace(), check_slug(argv[0]), argv[1:])


main(run)
