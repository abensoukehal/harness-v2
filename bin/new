#!/usr/bin/env python3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from harness import HarnessError, find_workspace, main
from harness.workspace import new


def run(argv):
    if len(argv) != 1:
        raise HarnessError("usage: new <slug>")
    print(new(find_workspace(), argv[0]))


main(run)
