#!/usr/bin/env python3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from harness import HARNESS_ROOT, HarnessError, main
from harness.rollback import rollback


def run(argv):
    root = HARNESS_ROOT
    if "--repo" in argv:
        i = argv.index("--repo")
        root = Path(argv[i + 1]).resolve()
        del argv[i:i + 2]
    if len(argv) > 1:
        raise HarnessError("usage: rollback [<tag>] [--repo DIR]")
    tag, commits = rollback(root, argv[0] if argv else None)
    print("rolled back to %s, reverting:" % tag)
    for c in commits:
        print("  " + c)
    print("push when ready: git -C %s push origin HEAD" % root)


main(run)
