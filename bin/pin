#!/usr/bin/env python3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

import os
from harness import HARNESS_ROOT, HarnessError, check_slug, main
from harness.workspace import pin


def run(argv):
    root = None
    if "--root" in argv:
        i = argv.index("--root")
        root = Path(argv[i + 1]) if i + 1 < len(argv) else None
        del argv[i:i + 2]
    if not 1 <= len(argv) <= 2:
        raise HarnessError("usage: pin <client> [<commit>] [--root DIR]")
    root = root or Path(os.environ.get("HARNESS_WORKSPACES") or HARNESS_ROOT.parent / "workspaces")
    ws = (root / check_slug(argv[0], "client name")).resolve()
    if not (ws / "product" / "client.config.yaml").exists():
        raise HarnessError("no workspace at %s" % ws)
    print(pin(ws, argv[1] if len(argv) == 2 else None))


main(run)
