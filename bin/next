#!/usr/bin/env python3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

import json
from harness import HarnessError, check_slug, find_workspace, main
from harness.next import next_batch


def run(argv):
    if len(argv) != 1:
        raise HarnessError("usage: next <slug>")
    print(json.dumps(next_batch(find_workspace(), check_slug(argv[0]))))


main(run)
