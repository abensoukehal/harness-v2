#!/usr/bin/env python3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from harness import HarnessError, check_slug, find_workspace, main
from harness.answer import answer


def run(argv):
    if len(argv) != 3:
        raise HarnessError("usage: answer <slug> <sub-task id> <letter>")
    reopened = answer(find_workspace(), check_slug(argv[0]), argv[1], argv[2].upper())
    print("%s back to pending%s; relaunch /harness-build %s" % (argv[1], (", reopened " + ", ".join(reopened)) if reopened else "", argv[0]))


main(run)
