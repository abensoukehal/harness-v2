#!/usr/bin/env python3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from harness import HarnessError, find_workspace, main
from harness.agents import show


def run(argv):
    if argv:
        raise HarnessError("usage: agents")
    show(find_workspace())


main(run)
