#!/usr/bin/env python3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from harness import HarnessError, check_slug, find_workspace, main
from harness.notify import notify


def run(argv):
    if len(argv) != 2:
        raise HarnessError("usage: notify <slug> <plan_ready|run_finished|needs_answer>")
    notify(find_workspace(), check_slug(argv[0]), argv[1], sys.stdout)


main(run)
