#!/usr/bin/env python3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from harness import HarnessError, check_slug, find_workspace, main
from harness.review import review


def run(argv):
    if len(argv) != 1:
        raise HarnessError("usage: review <slug>")
    print(review(find_workspace(), check_slug(argv[0])), end="")


main(run)
