{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harness:state",
  "title": "state.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feature",
    "kind",
    "harness_commit",
    "branch",
    "phase",
    "ports",
    "worktrees",
    "subtasks",
    "decisions",
    "frictions",
    "interventions",
    "accepted_gaps"
  ],
  "description": "Durations only. No timestamp, date or created/updated field ever lands here.",
  "properties": {
    "feature": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "kind": {
      "enum": [
        "ui",
        "service",
        "mixed"
      ]
    },
    "harness_commit": {
      "$ref": "#/$defs/sha"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "$ref": "#/$defs/phase"
    },
    "ports": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 65535
      }
    },
    "worktrees": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9._-]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^\\.worktrees/"
      }
    },
    "subtasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subtask"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "frictions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interventions": {
      "type": "array",
      "description": "Every time a human had to touch the run (6.2). Ordered by when it happened; no clock lands here.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "cause",
          "line"
        ],
        "properties": {
          "phase": {
            "$ref": "#/$defs/phase"
          },
          "cause": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "line": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    },
    "accepted_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subtask",
          "region",
          "divergence_pct"
        ],
        "properties": {
          "subtask": {
            "$ref": "#/$defs/subtaskId"
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "divergence_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "pair": {
            "type": "string"
          }
        }
      }
    },
    "client_test_baseline": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "ingestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stacks",
        "zones",
        "summary"
      ],
      "properties": {
        "stacks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "zones": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "wall_time_s": {
      "type": "integer",
      "minimum": 0
    },
    "cost_by_agent": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "tokens_in",
          "tokens_out",
          "duration_s"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "run": {
            "type": "string",
            "minLength": 1
          },
          "subtask": {
            "$ref": "#/$defs/subtaskId"
          },
          "tokens_in": {
            "$ref": "#/$defs/count"
          },
          "tokens_distinct": {
            "$ref": "#/$defs/count",
            "description": "Context counted once, not once per turn (6.2)."
          },
          "tokens_out": {
            "$ref": "#/$defs/count"
          },
          "turns": {
            "$ref": "#/$defs/count"
          },
          "locate_turns": {
            "$ref": "#/$defs/count",
            "description": "Turns spent finding ground: a grep, glob or find whose result is paths and line numbers (6.2)."
          },
          "duration_s": {
            "$ref": "#/$defs/count"
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "description": "The model that ran, from the agent's transcript (6.3)."
          },
          "effort": {
            "type": "string",
            "minLength": 1,
            "description": "The reasoning effort that ran, from the agent's transcript (6.3)."
          }
        }
      }
    },
    "net_commit": {
      "$ref": "#/$defs/sha"
    },
    "delivered": {
      "type": "boolean"
    },
    "plan_message": {
      "type": "string"
    },
    "reseeds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stack"
        ],
        "properties": {
          "stack": {
            "type": "string"
          },
          "subtask": {
            "$ref": "#/$defs/subtaskId"
          }
        }
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "phase": {
      "enum": [
        "ingestion",
        "planning",
        "safety_net",
        "build",
        "qa",
        "delivery",
        "retro",
        "finished"
      ]
    },
    "subtaskId": {
      "type": "string",
      "pattern": "^st-[0-9]{2,}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "subtask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stack",
        "status",
        "attempts",
        "interruptions",
        "worktree",
        "exit_criteria"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/subtaskId"
        },
        "stack": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "done",
            "blocked",
            "skipped"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "interruptions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "worktree": {
          "type": "string",
          "pattern": "^\\.worktrees/"
        },
        "goal": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/subtaskId"
          }
        },
        "line_budget": {
          "type": "integer",
          "minimum": 0
        },
        "token_budget": {
          "type": "integer",
          "minimum": 1
        },
        "exit_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tokens_in",
            "tokens_out",
            "duration_s"
          ],
          "properties": {
            "tokens_in": {
              "$ref": "#/$defs/count"
            },
            "tokens_out": {
              "$ref": "#/$defs/count"
            },
            "tokens_discarded": {
              "$ref": "#/$defs/count",
              "description": "Spent on an attempt that was superseded, and paid for a diff that did not survive (6.2)."
            },
            "duration_s": {
              "$ref": "#/$defs/count"
            }
          }
        },
        "commit": {
          "$ref": "#/$defs/sha"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "last_error": {
          "type": "string",
          "maxLength": 2000
        },
        "noted": {
          "description": "The one observation this sub-task recorded, the form from 5.5.",
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^/`\\n]+$"
        },
        "ask": {
          "$ref": "urn:harness:result#/$defs/ask"
        },
        "answer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "letter",
            "text"
          ],
          "properties": {
            "letter": {
              "enum": [
                "A",
                "B",
                "C"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "done"
              }
            }
          },
          "then": {
            "required": [
              "commit",
              "cost"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "blocked",
                  "skipped"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "criterion": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "test",
            "http",
            "browser",
            "log",
            "visual",
            "lint",
            "typecheck",
            "examples"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "test"
              }
            }
          },
          "then": {
            "required": [
              "pattern"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "http"
              }
            }
          },
          "then": {
            "required": [
              "method",
              "url",
              "expect_status"
            ],
            "properties": {
              "expect_status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "browser"
              }
            }
          },
          "then": {
            "required": [
              "script"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "log"
              }
            }
          },
          "then": {
            "required": [
              "stack",
              "pattern",
              "present"
            ],
            "properties": {
              "present": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "visual"
              }
            }
          },
          "then": {
            "required": [
              "region",
              "reference"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "examples"
              }
            }
          },
          "then": {
            "required": [
              "set",
              "floor"
            ],
            "properties": {
              "floor": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 1
              }
            }
          }
        }
      ]
    }
  }
}
